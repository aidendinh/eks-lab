<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.ekslab</groupId>
  <artifactId>orders-java</artifactId>
  <version>0.1.0</version>
  <name>orders-java</name>
  <description>JavaMelody-instrumented replacement for the Python orders service</description>

  <properties>
    <java.version>21</java.version>
    <!-- 2.8.0 is the Jakarta/Spring Boot 3 line. Spring Boot 2 (javax) needs 1.99.4;
         Spring Boot 4 uses the separate javamelody-spring-boot4-starter artifact. -->
    <javamelody.version>2.8.0</javamelody.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JdbcTemplate + HikariCP. JavaMelody wraps the DataSource to produce the
         SQL and connection-pool statistics that are its signature feature. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Required for javamelody.spring-monitoring-enabled: JavaMelody monitors
         @Service beans by auto-proxying them, which needs Spring AOP present.
         The starter does not pull this in transitively. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>net.bull.javamelody</groupId>
      <artifactId>javamelody-spring-boot-starter</artifactId>
      <version>${javamelody.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>orders-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
